#!/usr/bin/env bash
# Print this Claude Code session's messaging address (the name another agent uses with
# SendMessage), plus the peers it can reach. Reads the local session registry only -
# no model, no tool call. Source of truth: $CLAUDE_CONFIG_DIR/sessions/<pid>.json
#
# Other config dirs are scanned for live sessions that this one cannot message (messaging
# is scoped to one registry). By default that is ~/.claude and every ~/.claude-* dir that
# has a sessions/ folder; set CC_WHOAMI_CONFIG_DIRS (colon-separated) to choose them.
#
# Needs bash and jq. Liveness uses /proc when present (Linux), else kill -0.
set -uo pipefail

CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SEP=$'\x1f' # field separator; a tab would collapse empty fields in `read`

config_dirs() {
  if [[ -n ${CC_WHOAMI_CONFIG_DIRS:-} ]]; then
    tr ':' '\n' <<<"$CC_WHOAMI_CONFIG_DIRS"
  else
    local d
    for d in "$HOME/.claude" "$HOME"/.claude-*; do
      [[ -d $d/sessions ]] && printf '%s\n' "$d"
    done
  fi
}

# A registry entry is live only if its pid exists AND that pid is the same process that
# wrote the entry (procStart = field 22 of /proc/<pid>/stat, so a recycled pid is caught).
is_live() {
  local pid=$1 procstart=$2 actual
  if [[ ! -d /proc/self ]]; then
    kill -0 "$pid" 2>/dev/null
    return
  fi
  [[ -r /proc/$pid/stat ]] || return 1
  [[ -z $procstart || $procstart == null ]] && return 0
  actual=$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null) || return 1
  [[ $actual == "$procstart" ]]
}

ago() { # ms epoch -> "3d" / "4h" / "12m"
  local s=$(( ($(date +%s) * 1000 - ${1:-0}) / 1000 ))
  (( s < 0 )) && s=0
  if   (( s >= 86400 )); then echo "$((s/86400))d"
  elif (( s >= 3600  )); then echo "$((s/3600))h"
  else echo "$((s/60))m"; fi
}

read_entry() { # file -> SEP-separated fields
  jq -r '[.pid, .name, .status, .kind, .cwd, .sessionId, (.procStart//""), (.startedAt//0)]
         | map(if . == null then "" else tostring end) | join("\u001f")' "$1" 2>/dev/null
}

self_pid="${CLAUDE_PID:-}"
self_sid="${CLAUDE_CODE_SESSION_ID:-}"
self_found=0; peers=()

for f in "$CFG"/sessions/*.json; do
  [[ -e $f ]] || continue
  IFS=$SEP read -r pid name status kind cwd sid procstart started < <(read_entry "$f")
  [[ -n ${pid:-} ]] || continue
  is_live "$pid" "$procstart" || continue
  if [[ ( -n $self_pid && $pid == "$self_pid" ) || ( -n $self_sid && $sid == "$self_sid" ) ]]; then
    self_found=1
    printf 'This session: %s\n' "$name"
    printf '  reach it with:  SendMessage({to: "%s", message: "..."})\n' "$name"
    printf '  session id      %s\n' "$sid"
    printf '  pid %s in %s (config %s)\n' "$pid" "$cwd" "$CFG"
  else
    peers+=("$(printf '%s\t%s\t%s\t%s\t%s' "$name" "$status" "$kind" "${cwd##*/}" "$(ago "$started")")")
  fi
done

if (( ! self_found )); then
  printf 'This session: not found in %s/sessions (not an interactive session?)\n' "$CFG"
fi

if ((${#peers[@]})); then
  printf '\nPeers it can message (%d):\n' "${#peers[@]}"
  printf '%s\n' "${peers[@]}" | sort | awk -F'\t' '{printf "  %-18s %-7s %-12s %-22s %s\n", $1, $2, $3, $4, $5}'
else
  printf '\nPeers it can message: none live.\n'
fi

# Sessions under a different config dir are live but unreachable: messaging is scoped to
# one registry, so ListAgents will not show them either.
others=()
while IFS= read -r d; do
  [[ -n $d && -d $d ]] || continue
  [[ $d -ef $CFG ]] && continue
  for f in "$d"/sessions/*.json; do
    [[ -e $f ]] || continue
    IFS=$SEP read -r pid name status kind cwd sid procstart started < <(read_entry "$f")
    [[ -n ${pid:-} ]] || continue
    is_live "$pid" "$procstart" || continue
    others+=("$(printf '%s\t%s\t%s\t%s' "$name" "$status" "${cwd##*/}" "${d##*/}")")
  done
done < <(config_dirs)
if ((${#others[@]})); then
  printf '\nLive under another config dir, NOT addressable from here (%d):\n' "${#others[@]}"
  printf '%s\n' "${others[@]}" | sort | awk -F'\t' '{printf "  %-18s %-7s %-22s %s\n", $1, $2, $3, $4}'
fi
